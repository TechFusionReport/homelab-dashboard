# Copy through scripts/bootstrap.py. Replace values locally, never in public templates.
HOMEPAGE_IMAGE=ghcr.io/gethomepage/homepage:v2.7.0
DASHBOARD_BIND_ADDRESS=127.0.0.1
DASHBOARD_PORT=3000
HOMEPAGE_ALLOWED_HOSTS=localhost:3000,127.0.0.1:3000
TZ=America/New_York

# Browser-facing URL and server-facing API URL can differ.
HOMEPAGE_VAR_PROWLARR_URL=http://media.example.invalid:9696
HOMEPAGE_VAR_PROWLARR_API_URL=http://media.example.invalid:9696
HOMEPAGE_VAR_PROWLARR_KEY=replace-locally
HOMEPAGE_VAR_RADARR_URL=http://media.example.invalid:7878
HOMEPAGE_VAR_RADARR_API_URL=http://media.example.invalid:7878
HOMEPAGE_VAR_RADARR_KEY=replace-locally
HOMEPAGE_VAR_SONARR_URL=http://media.example.invalid:8989
HOMEPAGE_VAR_SONARR_API_URL=http://media.example.invalid:8989
HOMEPAGE_VAR_SONARR_KEY=replace-locally
HOMEPAGE_VAR_QBITTORRENT_URL=http://media.example.invalid:8080
HOMEPAGE_VAR_QBITTORRENT_API_URL=http://media.example.invalid:8080
HOMEPAGE_VAR_QBITTORRENT_USERNAME=replace-locally
HOMEPAGE_VAR_QBITTORRENT_PASSWORD=replace-locally
HOMEPAGE_VAR_JELLYFIN_URL=http://media.example.invalid:8096
HOMEPAGE_VAR_JELLYFIN_API_URL=http://media.example.invalid:8096
HOMEPAGE_VAR_JELLYFIN_KEY=replace-locally
HOMEPAGE_VAR_PLEX_URL=http://media.example.invalid:32400/web
HOMEPAGE_VAR_THREADFIN_URL=http://media.example.invalid:34400/web/

HOMEPAGE_VAR_HEALTH_URL=http://127.0.0.1:3081
HOMEPAGE_VAR_PIHOLE_URL=http://dns.example.invalid/admin/
HOMEPAGE_VAR_HOMEASSISTANT_URL=http://home.example.invalid:8123
HOMEPAGE_VAR_NETALERTX_URL=http://network.example.invalid
HOMEPAGE_VAR_N8N_URL=https://automation.example.invalid
HOMEPAGE_VAR_VAULTWARDEN_URL=https://vault.example.invalid
HOMEPAGE_VAR_SYNCTHING_URL=http://sync.example.invalid:8384


