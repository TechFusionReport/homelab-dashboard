[Unit]
Description=Homelab preview read-only health collector
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=REPLACE_USER
WorkingDirectory=REPLACE_CHECKOUT
ExecStart=/usr/bin/python3 REPLACE_CHECKOUT/collectors/health.py --config REPLACE_CHECKOUT/local/health.json
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
# Read-only collector: no capabilities, no writes outside its private /tmp, network and local sockets only.
CapabilityBoundingSet=
ProtectSystem=full
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
